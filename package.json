{
  "name": "dsh-vram-switcher",
  "version": "2.0.3",
  "description": "Native DSH Cordis plugin + AstrBot adapter for local AI companions: coordinate LLM, IndexTTS and ComfyUI on one GPU.",
  "type": "module",
  "main": "dsh-plugin/index.js",
  "exports": {
    ".": "./dsh-plugin/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin/index.js",
    "dsh-plugin/daemon.py",
    "vram_switcher/*.py",
    "cordis.patch.yml",
    "configure.py",
    "profile.example.json",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "dsh-plugin.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "astrbot",
    "astrbot-plugin",
    "indextts",
    "ai-companion",
    "vram",
    "gpu",
    "comfyui",
    "tts",
    "llama.cpp",
    "windows"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">4.0.4-0 <5 || >=4.1.0-rc.0 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao150/vram-switcher.git"
  },
  "homepage": "https://github.com/xiaoxiao150/vram-switcher",
  "bugs": {
    "url": "https://github.com/xiaoxiao150/vram-switcher/issues"
  }
}
